local ai = require "modules.ai"

function init(self)
	local id = go.get_id()
	local position = go.get_position()

	local shape = physics.get_shape("#collisionobject", "outline")
	local width, height
	if shape.diameter then
		width = shape.diameter
		height = shape.diameter
	elseif shape.dimensions then
		width = shape.dimensions.x
		height = shape.dimensions.y
	end

	if width and height then
		ai.add_barrier(id, {
			position = position,
			width = width,
			height = height
		})
	end
end

function final(self)
	local id = go.get_id()
	ai.remove_barrier(id)
end
