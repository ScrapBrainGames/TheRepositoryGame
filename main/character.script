	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("player control") then
		self.player = true
		msg.post(".", "acquire_input_focus")
	elseif message_id == hash("contact_point_response") then
		-- Handle collisions with walls and barriers
		local position = go.get_position()
		position = position + message.normal * (message.distance + 1)
		go.set_position(position)
	elseif message_id == hash("damage") then
		self.health = self.health - message.damage
		if self.health <= 0 then
			go.delete()
		end
	end
end

function on_input(self, action_id, action)
	if action_id == hash("left") then
		self.direction.x = -1
	elseif action_id == hash("right") then
		self.direction.x = self.direction.x + 1
	elseif action_id == hash("up") then
		self.direction.y = 1
	elseif action_id == hash("down") then
		self.direction.y = self.direction.y - 1
	elseif action_id == hash("fire") and action.pressed then
		if self.aiming then
			fire(self)
		end
	elseif action_id == hash("aim") then
		if action.pressed then
			aim(self)
		elseif action.released then
			lower(self)
		end
	elseif action.x then
		self.mouse = camera.screen_xy_to_world(action.screen_x, action.screen_y)
	elseif action_id == hash("reload") then
		self.weapon:reload()
	end
end

