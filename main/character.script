local weapons = require "main.weapons"

-- Which character is this?
go.property("Character", "Clint")
go.property("radius", 18)

local function aim(self)
	self.aiming = true
	self.weapon:cycle()
end

local function lower(self)
	self.aiming = false
	self.weapon.cocked = false
end

local function fire(self)
	if self.weapon.cocked then
		if self.weapon:fire() then
			-- Bang!
			print("bang")

			local position = go.get_position()
			local direction = self.mouse - position
			direction.z = 0
			direction = vmath.normalize(direction)
			position = position + direction * 32

			local props = {
				direction = direction,
				speed = 400,
				damage = 1,
				sender = go.get_id()
			}
			local bullet = factory.create("#factory", position, nil, props)
		else
			-- Click!
			print("click")
		end
	else
		-- Do we want the weapon to cycle on left click?
		--self.weapon:cycle()
	end
	pprint(self.weapon.chambers)
end

function init(self)
	self.player = false
	self.direction = vmath.vector3()
	self.mouse = vmath.vector3()
	self.health = 3
	self.aim_movement = 60
	self.normal_movement = 180
	self.aiming = false

	-- Fill your hand, you son of a bitch
	self.weapon = weapons.get()
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	-- Set speed dependent on aiming or not
	local speed = self.aiming and self.aim_movement or self.normal_movement

	local position = go.get_position()

	if self.direction.x ~= 0 or self.direction.y ~= 0 then
		self.direction = vmath.normalize(self.direction)
		position = position + self.direction * speed * dt
		go.set_position(position)
	end

	self.direction.x = 0
	self.direction.y = 0
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
