local state = require "modules.state"

local saloon = {
	playing = false,
	position = vmath.vector3(),
	music = -1,
	gain = 0,
}

local music = {
	sting = {},
	ambient = {},
	combat = {},
	finale = {},
}

local queue = {
	current = nil,
	index = 1,
}

function queue:play(type)
	if self.current and self.index then
		sound.stop(music[self.current][self.index])
	end
	self.current = type
	self.index = 1
	self.last = sound.play(music[self.current][self.index])
end

function queue:next()
	if self.current == "combat" then
		if state.combat then
			next = "combat"
			self.index = self.index % #music.combat + 1
		else
			next = "finale"
		end
	else
		local next
		if self.current == "combat" then
			if state.combat then
				next = "combat"
				self.index = self.index % #music.combat + 1
			else
				next = "finale"
			end
		elseif self.current == "ambient" then
			next = math.random() < 0.5 and "ambient" or "sting"
			self.index = math.random(#music[next])
		else
			next = "ambient"
			self.index = math.random(#music.ambient)
		end
		print("next up:" .. next)
		self.current = next
		-- Play the next track
		sound.play(music[self.current][self.index], nil, self:next())
	end
end

local function play(self)
	local current
	local index
	return function(type)
		if type then
			-- Stop whatever's playing
			if current and index then
				sound.stop(music[current][index])
			end
			current = type
			index = 1
			sound.play(music[current][index], nil, self.play)
		else
			local next
			if current == "combat" then
				if state.combat then
					next = "combat"
					index = index % #music.combat + 1
				else
					next = "finale"
				end
			elseif current == "ambient" then
				next = math.random() < 0.5 and "ambient" or "sting"
				index = math.random(#music[next])
			else
				next = "ambient"
				index = math.random(#music.ambient)
			end
			print("next up:" .. next)
			current = next
			-- Play the next track
			sound.play(music[current][index], nil, self.play)
		end
	end
end

function init(self)
	music.sting = { "#sting1", "#sting2", "#sting3", "#sting4", }
	music.ambient = { "#ambient1" }
	music.combat = { "#combat1", "#combat1", }
	music.finale = { "#finale1", "#finale1" }

	self.play = play(self)
	self.play("sting")
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	if saloon.playing then
		local player = state.player.position
		local direction = saloon.position - player
		saloon.gain = 10000 / (vmath.length_sqr(direction) + 1)
		local pan = direction.x / (math.abs(direction.y) + math.abs(direction.x) + 1)
		sound.set_gain("#saloon", saloon.gain)
		sound.set_pan("#saloon", pan)
	elseif saloon.gain >= 0 then
		saloon.gain = saloon.gain - (dt * 0.25)
		sound.set_gain("#saloon", saloon.gain)
	else
		sound.stop("#saloon")
	end
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("start_saloon") then
		saloon.playing = true
		saloon.position = message.position
		saloon.music = sound.play("#saloon")
	elseif message_id == hash("stop_saloon") then
		saloon.playing = false
	end
end

