go.property("text", "POP!")
go.property("duration", 0.125)
go.property("angled", true)

function init(self)
	if self.angled then
		local q = vmath.quat_rotation_z(math.rad(math.random(-15, 15)))
		go.set_rotation(q)
	end
	go.set("#label", "text", self.text)
	timer.delay(self.duration, false, function()
		go.delete()
	end)
end
