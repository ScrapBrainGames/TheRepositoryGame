local characters = require "modules.characters"
local ai = require "modules.ai"
local transition = require "modules.transition"

-- Which character is this?
go.property("character", "default")
go.property("player", false)

local function update_hud(self)
	if self.player then
		msg.post(self.hud, "chambers", { chambers = self.weapon.chambers })
	end
end

local function aim(self)
	self.aiming = true
	if not self.weapon.reloading then
		self.weapon:cycle()
	end
end

local function lower(self)
	self.aiming = false
	self.weapon:decock()
end

local function fire(self)
	local direction = self.target - self.position
	self.weapon:fire(self.position, direction)
	self.trigger = false
end

local function set_player(self)
	self.player = true
	msg.post(".", "acquire_input_focus")
	msg.post("/camera#control", "set_player", { id = go.get_id() })
	self.hud = msg.url("/camera#weapon")
	msg.post(self.hud, "set", { weapon = self.weapon.name })
	characters.player = self.character
	-- Give the player a slight health advantage
	self.state.max_health = 12
	-- Register as player
	transition.register(self.id, true)
end

function init(self)
	-- self state is used by both player and AI control
	self.id = go.get_id()
	self.position = vmath.vector3()
	self.direction = vmath.vector3()
	self.target = vmath.vector3()
	self.aiming = false
	-- Initialize per-character parameters like health, speed, and weapon
	characters.initialize(self, self.character)
	-- Set camera to follow or AI to control
	if self.player then
		set_player(self)
		if reloadtime then
			self.reloadtimer = self.weapon:reload(reloadtime)
			reloadtime = nil
		end
	else
		self.ai = ai.new(self)
		self.weapon:reload(0)
	end
	-- Somewhere out there is a bullet with your name on it
	self.weapon:set(self.id)
	-- Hide the health bar until hit?
	go.set("#health", "scale.x", self.state.health / self.state.max_health)
	-- Health regen
	timer.delay(3, true, function()
		if self.state.health < self.state.max_health then
			self.state.health = self.state.health + 1
			go.set("#health", "scale.x", self.state.health / self.state.max_health)
		end
	end)
	-- Register for camera tracking etc.
	transition.register(self.id)
end

function update(self, dt)
	-- Set speed dependent on aiming or not
	local speed = self.normal_movement
	if self.aiming then
		speed = self.aim_movement
	elseif self.weapon.reloading then
		speed = self.reload_movement
	end
	-- Get current position
	self.position = go.get_position()
	-- Player has a HUD and sends info to AI, enemy listens to AI
	if self.player then
		update_hud(self)
		local velocity = go.get("#collisionobject", "linear_velocity")
		ai.set_player_position(self.position, velocity)
		-- If holding trigger, fire when ready (input buffer)
		if self.aiming and self.trigger and self.weapon.cocked then
			fire(self)
		end
	else
		local target = ai.get_player_position()
		local cast = physics.raycast(self.position, target, { hash("level") })
		local sighted = cast == nil
		ai.update(self.ai, dt, sighted)
	end
	-- Move by forces
	if self.direction.x ~= 0 or self.direction.y ~= 0 then
		self.direction = vmath.normalize(self.direction)
		msg.post("#collisionobject", "apply_force", { force = self.direction * speed, position = self.position })
	end
	-- Reset move direction
	self.direction.x = 0
	self.direction.y = 0
end

function on_message(self, message_id, message, sender)
	if message_id == hash("damage") then
		self.state.health = self.state.health - message.damage
		if self.state.health <= 0 then
			go.delete()
			if self.player then
				msg.post(message.sender, "set_player")
			end
		else
			go.set("#health", "scale.x", self.state.health / self.state.max_health)
		end
	elseif message_id == hash("set_player") then
		set_player(self)
		self.aiming = false
	end
end

function on_input(self, action_id, action)
	if action.screen_x then
		self.target = camera.screen_xy_to_world(action.screen_x, action.screen_y)
	end
	if action_id == hash("left") then
		self.direction.x = -1
	elseif action_id == hash("right") then
		self.direction.x = self.direction.x + 1
	elseif action_id == hash("up") then
		self.direction.y = 1
	elseif action_id == hash("down") then
		self.direction.y = self.direction.y - 1
	elseif action_id == hash("fire") and self.aiming then
		if action.pressed then
			self.trigger = true
		elseif action.released then
			self.trigger = false
		end
	elseif action_id == hash("aim") then
		if action.pressed then
			aim(self)
		elseif action.released then
			lower(self)
		end
	elseif action_id == hash("reload") and action.pressed then
		self.reloadtimer = self.weapon:reload() or self.reloadtimer
	elseif action_id == hash("spin") and action.pressed then
		self.weapon:spin()
	end
end

function final(self)
	transition.remove(self.id)
	if self.player and self.reloadtimer then
		local timer = timer.get_info(self.reloadtimer)
		if timer then
			reloadtime = timer.time_remaining
		end
	end
end
