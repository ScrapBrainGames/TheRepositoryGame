go.property("direction", vmath.vector3())
go.property("speed", 1)
go.property("damage", 1)
go.property("sender", hash(""))

go.property("ricochet", -0.5)

function init(self)
	self.timer = 5
end

function update(self, dt)
	local position = go.get_position()
	position = position + self.direction * self.speed * dt
	go.set_position(position)

	self.timer = self.timer - dt
	if self.timer <= 0 then go.delete() end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") then
		-- Hit a character?
		if message.other_group == hash("player") then
			if not self.disabled then
				self.disabled = true
				msg.post(message.other_id, "damage", { damage = self.damage, sender = self.sender })
				go.delete()
			end
		elseif message.other_id ~= self.last then
			-- Check for deflection
			local normal = message.normal
			local dot = vmath.dot(self.direction, normal)
			if dot < 0 and dot > self.ricochet then
				self.direction = self.direction - 2 * dot * normal
				local direction = self.direction
				go.set_rotation(
					vmath.quat(
						0, 0,
						(direction.y > 0 and 1 or -1) * (direction.x < 1 and math.sqrt(0.5 * (1 - direction.x)) or 0),
						(direction.x > -1 and math.sqrt(direction.x * 0.5 + 0.5) or 0)
					)
				)
				self.last = message.other_id
			else
				go.delete()
			end
		end
	end
end
