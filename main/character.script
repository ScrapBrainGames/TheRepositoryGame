-- Which character is this?
go.property("Character", "Clint")
go.property("radius", 18)

local function fire(self)
	local position = go.get_position()
	local direction = self.mouse - position
	direction.z = 0
	direction = vmath.normalize(direction)

	local props = {
		direction = direction,
		speed = 400,
		damage = 1
	}
	local bullet = factory.create("#factory", nil, nil, props)
end

function init(self)
	self.player = false
	self.direction = vmath.vector3()
	self.mouse = vmath.vector3()
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	local speed = 180
	local position = go.get_position()

	if self.direction.x ~= 0 or self.direction.y ~= 0 then
		self.direction = vmath.normalize(self.direction)
		position = position + self.direction * speed * dt
		go.set_position(position)
	end

	self.direction.x = 0
	self.direction.y = 0
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("player control") then
		self.player = true
		msg.post(".", "acquire_input_focus")
	elseif message_id == hash("contact_point_response") then
		-- Handle collisions with walls and barriers
		local position = go.get_position()
		position = position + message.normal * message.distance
		go.set_position(position)
	end
end

function on_input(self, action_id, action)
	if action_id == hash("left") then
		self.direction.x = -1
	elseif action_id == hash("right") then
		self.direction.x = self.direction.x + 1
	elseif action_id == hash("up") then
		self.direction.y = 1
	elseif action_id == hash("down") then
		self.direction.y = self.direction.y - 1
	elseif action_id == hash("fire") and action.pressed then
		fire(self)
	elseif action.x then
		self.mouse = camera.screen_xy_to_world(action.screen_x, action.screen_y)
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
