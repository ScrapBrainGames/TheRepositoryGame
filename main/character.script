local characters = require "modules.characters"
local ai = require "modules.ai"
local state = require "modules.state"

-- Which character is this?
go.property("character", "default")
go.property("player", false)

-- Sprite sheets
-- Cleef
go.property("cleef_body", resource.tile_source("/assets/characters/cleef/body.tilesource"))
go.property("cleef_hat", resource.tile_source("/assets/characters/cleef/hat.tilesource"))
go.property("cleef_hand", resource.atlas("/assets/characters/cleef/hand.atlas"))
-- Clint
go.property("clint_body", resource.tile_source("/assets/characters/clint/body.tilesource"))
go.property("clint_hat", resource.tile_source("/assets/characters/clint/hat.tilesource"))
go.property("clint_hand", resource.atlas("/assets/characters/clint/hand.atlas"))
-- Snuffy
go.property("snuffy_body", resource.tile_source("/assets/characters/snuffy/body.tilesource"))
go.property("snuffy_hat", resource.tile_source("/assets/characters/snuffy/hat.tilesource"))
go.property("snuffy_hand", resource.atlas("/assets/characters/snuffy/hand.atlas"))
-- Sixgun
go.property("weapon", resource.atlas("/assets/weapons/weapons.atlas"))


local function update_hud(self)
	if self.player then
		msg.post(self.hud, "chambers", { chambers = self.weapon.chambers })
	end
end

local function aim(self)
	self.aiming = true
end

local function lower(self)
	self.aiming = false
end

local function fire(self)
	local position = self.position
	local target = self.target
	if not self.aiming then
		target = target +
			vmath.vector3(math.random() * 2 - 1, math.random() * 2 - 1, 0) * vmath.length(target - position) * 0.25
	end
	local direction = target - position
	self.weapon:fire(self.position, direction)
	self.trigger = false
end

local function set_player(self)
	self.player = true
	msg.post(".", "acquire_input_focus")
	msg.post("/camera#control", "set_player", { id = go.get_id() })
	self.hud = msg.url("/camera#weapon")
	msg.post(self.hud, "set", { weapon = self.weapon.name })
	characters.player = self.character
	-- Give the player a slight health advantage
	self.state.max_health = self.state.handicap
	-- Register as player
	state.register(self.id, true)
end

local function set_sprite(self)
	if self.character == "empty" then
		go.set("#body", "image", self.cleef_body)
		go.set("#hat", "image", self.cleef_hat)
		go.set(self.hand_url, "image", self.cleef_hand)
	elseif self.character == "default" then
		go.set("#body", "image", self.clint_body)
		go.set("#hat", "image", self.clint_hat)
		go.set(self.hand_url, "image", self.clint_hand)
	elseif self.character == "sixgun" then
		go.set("#body", "image", self.cleef_body)
		go.set("#hat", "image", self.cleef_hat)
		go.set(self.hand_url, "image", self.cleef_hand)
	elseif self.character == "singlegun" then
		go.set("#body", "image", self.clint_body)
		go.set("#hat", "image", self.clint_hat)
		go.set(self.hand_url, "image", self.clint_hand)
	elseif self.character == "shotgun" then
		go.set("#body", "image", self.snuffy_body)
		go.set("#hat", "image", self.snuffy_hat)
		go.set(self.hand_url, "image", self.snuffy_hand)
	end
end

local function animation(self)
	set_sprite(self)
	sprite.play_flipbook(self.gun_url, self.weapon.name)
	local last = "idle"
	local flip = false
	local pointing = vmath.vector3(1, 0, 0)
	local epsilon = 144
	return function(velocity)
		-- Update pointing direction
		local direction = self.target - self.position
		direction = vmath.normalize(direction)
		direction = vmath.slerp(0.2, pointing, direction)
		pointing = direction
		if direction.x > 0 then
			if flip then
				sprite.set_hflip("#body", false)
				sprite.set_hflip("#hat", false)
				sprite.set_vflip(self.arm, false)
				flip = false
			end
		elseif direction.x < 0 then
			if not flip then
				sprite.set_hflip("#body", true)
				sprite.set_hflip("#hat", true)
				sprite.set_vflip(self.arm, true)
				flip = true
			end
		end
		-- Set current animation
		local current = "idle"
		if vmath.length_sqr(velocity) > epsilon then
			if velocity.y < velocity.x and velocity.y < -velocity.x then
				current = "walk"
			elseif velocity.y > velocity.x and velocity.y > -velocity.x then
				current = "back"
			elseif velocity.x * direction.x < 0 then
				current = "back"
			elseif velocity.x * direction.x > 0 then
				current = "walk"
			else
				current = last
			end
			-- Scale the animation rate to |velocity|/max_speed
			local rate = vmath.length(velocity) / self.normal_movement
			go.set("#body", "playback_rate", rate)
			go.set("#hat", "playback_rate", rate)
		end
		-- Change animation
		if last ~= current then
			sprite.play_flipbook("#body", current)
			sprite.play_flipbook("#hat", current)
			last = current
		end
		-- Point arm/gun
		local q = vmath.quat_rotation_z(math.atan2(direction.y, direction.x))
		go.set_rotation(q, self.arm)
	end
end

function init(self)
	-- self state is used by both player and AI control
	self.id = go.get_id()
	self.position = vmath.vector3()
	self.direction = vmath.vector3()
	self.target = vmath.vector3()
	self.aiming = false
	-- Add an arm
	self.arm = factory.create("#arm")
	go.set_parent(self.arm, self.id)
	go.set_position(vmath.vector3(0, 0, 0), self.arm)
	self.hand_url = msg.url(nil, self.arm, "hand")
	self.gun_url = msg.url(nil, self.arm, "gun")
	-- Initialize per-character parameters like health, speed, and weapon
	characters.initialize(self, self.character)
	-- Set camera to follow or AI to control
	if self.player then
		set_player(self)
	else
		self.ai = ai.new(self)
		self.weapon:reload(0)
	end
	-- Somewhere out there is a bullet with your name on it
	self.weapon:set(self.id)
	-- Refill health on start
	if self.state.health > 0 then self.state.health = self.state.max_health end
	-- Hide the health bar until hit?
	go.set("#health", "scale.x", self.state.health / self.state.max_health)
	-- Health regen
	timer.delay(3, true, function()
		if self.state.health < self.state.max_health then
			self.state.health = self.state.health + 1
			go.set("#health", "scale.x", self.state.health / self.state.max_health)
		end
	end)
	-- Register for camera tracking etc.
	state.register(self.id, nil, self.character)
	-- Set animations
	self.animation = animation(self)
end

function update(self, dt)
	-- Update weapon
	self.weapon:update(dt)
	-- Set speed dependent on aiming or not
	local speed = self.normal_movement
	if self.aiming then
		speed = self.aim_movement
	elseif self.weapon.reloading then
		speed = self.reload_movement
	end
	-- Get current position and velocity
	self.position = go.get_position()
	local velocity = go.get("#collisionobject", "linear_velocity")
	-- Player has a HUD and sends info to AI, enemy listens to AI
	if self.player then
		update_hud(self)
		state.player.position = self.position
		ai.set_player_position(self.position, velocity)
		-- If holding trigger, fire when ready (input buffer)
		if self.trigger and self.weapon.cocked then
			fire(self)
		end
	else
		local target = ai.get_player_position()
		local cast = physics.raycast(self.position, target, { hash("level") })
		local sighted = cast == nil
		ai.update(self.ai, dt, sighted)
	end
	-- Move by forces
	if self.direction.x ~= 0 or self.direction.y ~= 0 then
		self.direction = vmath.normalize(self.direction)
		msg.post("#collisionobject", "apply_force", { force = self.direction * speed, position = self.position })
	end
	-- Animate
	self.animation(velocity)
	-- Reset move direction
	self.direction.x = 0
	self.direction.y = 0
end

function on_message(self, message_id, message, sender)
	if message_id == hash("damage") then
		self.state.health = self.state.health - message.damage
		if self.state.health <= 0 then
			state.kill(self.id, self.player or not self.lesser)
			characters.died(self.character)
			go.delete(self.id, true)
			if self.player and (state.characters[message.sender] ~= nil) then
				msg.post(message.sender, "set_player")
			end
		else
			go.set("#health", "scale.x", self.state.health / self.state.max_health)
			if self.player then
				-- ???
			else
				ai.react(self.ai)
			end
		end
	elseif message_id == hash("set_player") then
		set_player(self)
		self.aiming = false
	end
end

function on_input(self, action_id, action)
	if action.screen_x then
		self.target = camera.screen_xy_to_world(action.screen_x, action.screen_y)
	end
	if action_id == hash("left") then
		self.direction.x = self.direction.x - 1
	elseif action_id == hash("right") then
		self.direction.x = self.direction.x + 1
	elseif action_id == hash("up") then
		self.direction.y = self.direction.y + 1
	elseif action_id == hash("down") then
		self.direction.y = self.direction.y - 1
	elseif action_id == hash("fire") then
		if action.pressed then
			self.trigger = true
		elseif action.released then
			self.trigger = false
		end
	elseif action_id == hash("aim") then
		if action.pressed then
			aim(self)
		elseif action.released then
			lower(self)
		end
	elseif action_id == hash("reload") and action.pressed then
		self.weapon:reload()
	elseif action_id == hash("spin") and action.pressed then
		self.weapon:cycle()
	end
end

function final(self)
	state.remove(self.id)
end
