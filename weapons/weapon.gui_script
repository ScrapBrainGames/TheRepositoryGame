local function set(self, type)
	for _, node in pairs(self.containers) do
		gui.set_enabled(node, false)
	end
	if type == "empty" or type == "dynamite" then return end
	gui.set_enabled(self.containers[type], true)

	self.nodes = {}
	if type == "sixgun" then
		for i = 1, 6 do
			self.nodes[i] = gui.get_node("chamber" .. i)
		end
	elseif type == "shotgun" then
		for i = 1, 2 do
			self.nodes[i] = gui.get_node("barrel" .. i)
		end
	elseif type == "singlegun" then
		self.nodes[1] = gui.get_node("single")
	end
end

function init(self)
	self.containers = {
		sixgun = gui.get_node("sixgun"),
		shotgun = gui.get_node("shotgun"),
		singlegun = gui.get_node("singlegun")
	}
	self.crosshair = {
		node = gui.get_node("crosshair"),
		left = gui.get_node("left"),
		right = gui.get_node("right"),
	}
	msg.post(".", "acquire_input_focus")
	defos.set_cursor_visible(false)

	self.cocked = false
	self.aiming = false
	gui.set_visible(self.crosshair.left, false)
	gui.set_visible(self.crosshair.right, false)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("crosshair") then
		if message.aiming and not self.aiming then
			self.aiming = true
			gui.animate(self.crosshair.left, "position", vmath.vector3(), gui.EASING_OUTQUAD, 0.125)
			gui.animate(self.crosshair.right, "position", vmath.vector3(), gui.EASING_OUTQUAD, 0.125)
		elseif self.aiming and not message.aiming then
			self.aiming = false
			gui.animate(self.crosshair.left, "position", vmath.vector3(-8, 0, 0), gui.EASING_OUTQUAD, 0.125)
			gui.animate(self.crosshair.right, "position", vmath.vector3(8, 0, 0), gui.EASING_OUTQUAD, 0.125)
		end
		if message.cocked and not self.cocked then
			self.cocked = true
			gui.set_visible(self.crosshair.left, true)
			gui.set_visible(self.crosshair.right, true)
		elseif self.cocked and not message.cocked then
			self.cocked = false
			gui.set_visible(self.crosshair.left, false)
			gui.set_visible(self.crosshair.right, false)
		end
	elseif message_id == hash("chambers") then
		for i, loaded in ipairs(message.chambers) do
			gui.play_flipbook(self.nodes[i], loaded and "loaded" or "empty")
		end
	elseif message_id == hash("set") then
		set(self, message.weapon)
	end
end

function on_input(self, action_id, action)
	if action.screen_x then
		gui.set_screen_position(self.crosshair.node, vmath.vector3(action.screen_x, action.screen_y, 0))
	end
end
