local function set(self, type)
	for _, node in pairs(self.containers) do
		gui.set_enabled(node, false)
	end
	gui.set_enabled(self.containers[type], true)

	self.nodes = {}
	if type == "sixgun" then
		for i = 1, 6 do
			self.nodes[i] = gui.get_node("chamber" .. i)
		end
	elseif type == "shotgun" then
		for i = 1, 2 do
			self.nodes[i] = gui.get_node("barrel" .. i)
		end
	elseif type == "singlegun" then
		self.nodes[1] = gui.get_node("single")
	end
end

function init(self)
	self.containers = {
		sixgun = gui.get_node("sixgun"),
		shotgun = gui.get_node("shotgun"),
		singlegun = gui.get_node("singlegun")
	}

	self.weapon = {}
	--self.sixgun = gui.get_node("sixgun")
	--self.shotgun = gui.get_node("shotgun")
	self.weapon.shotgun = function()
		self.nodes = {}
		for i = 1, 2 do
			self.nodes[i] = gui.get_node("barrel" .. i)
		end
		set(self, "shotgun")
	end

	self.weapon.sixgun = function()
		self.nodes = {}
		for i = 1, 6 do
			self.nodes[i] = gui.get_node("chamber" .. i)
		end
		set(self, "shotgun")
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("chambers") then
		for i, loaded in ipairs(message.chambers) do
			gui.play_flipbook(self.nodes[i], loaded and "loaded" or "empty")
		end
	elseif message_id == hash("set") then
		set(self, message.weapon)
	end
end
