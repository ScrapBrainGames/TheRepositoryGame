local characters = require "modules.characters"
local state = require "modules.state"
local map = require "modules.map"

go.property("index", 1)

function init(self)
	local position = go.get_position()
	if state.previous == map.get(state.current, self.index) then
		factory.create("#factory", position, nil, { character = characters.player, player = true })
		state.start = position
		state.entrance = msg.url()
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("respawn") then
		factory.create("#factory", go.get_position(), nil, { character = "mook", player = true, respawn = true })
	end
end
