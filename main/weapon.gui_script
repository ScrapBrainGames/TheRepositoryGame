function init(self)
	self.nodes = {}
	for i = 1, 6 do
		self.nodes[i] = gui.get_node("chamber" .. i)
	end
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("chambers") then
		for i, loaded in ipairs(message.chambers) do
			gui.play_flipbook(self.nodes[i], loaded and "loaded" or "empty")
		end
	end
end

