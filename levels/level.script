local state = require "modules.state"

go.property("tilemap", msg.url("/level#tilemap"))

function init(self)
	state.tilemap = self.tilemap
end

function final(self)
	state.tilemap = nil
end

function update(self, dt)
	local count, id = state.count()
	if count >= 2 then
		self.combat = true
		state.combat = true
		msg.post("main:/jukebox#jukebox", "combat")
	elseif self.combat then
		self.combat = false
		state.combat = false
		if count == 1 then
			-- One survivor
			state.ending(id)
		elseif count == 0 then
			-- No survivors
			print("No survivors")
		end
	end
end
