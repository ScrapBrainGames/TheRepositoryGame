local state = require "main.state"

local saloon = {
	playing = false,
	position = vmath.vector3(),
	music = -1,
	gain = 0,
}

local music = {
	sting = {},
	ambient = {},
	combat = {},
	finale = {},
}

local queue = {
	current = nil,
	index = 1,
}

function queue:combat()

end

function queue:sting()
	local index = math.random(#music.sting)
	sound.play(music.sting[index], nil, function()
		if not self.current then
			queue:ambient()
		end
	end)
end

function queue:ambient()
	local index = math.random(#music.ambient)
	self.current = music.ambient[index]
	sound.play(self.current, nil, function()
		queue:ambient()
	end)
end

function init(self)
	-- Silence for debugging
	--sound.set_group_gain("master", 0)

	music.sting = { "#sting1", "#sting2", "#sting3", "#sting4", "#sting5", }
	music.ambient = { "#ambient1", "#ambient2" }
	music.combat = { "#combat" }
	music.finale = { "#finale1", "#finale2", "#finale3", "#finale4", "#finale5", "#finale6", "#finale7", "#finale8",
		"#finale9", "#finale10", "#finale11", "#finale12", "#finale13", "#finale14", "#finale15", "#finale16", }

	queue:ambient()
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	if saloon.playing then
		local player = state.player.position
		local direction = saloon.position - player
		saloon.gain = 10000 / (vmath.length_sqr(direction) + 1)
		saloon.gain = math.min(saloon.gain, 1)
		local pan = direction.x / (math.abs(direction.y) + math.abs(direction.x) + 1)
		sound.set_gain("#saloon", saloon.gain)
		sound.set_pan("#saloon", pan)
	elseif saloon.gain > 0 then
		saloon.gain = math.max(0, saloon.gain - (dt * 0.25))
		sound.set_gain("#saloon", saloon.gain)
		if saloon.gain == 0 then
			sound.stop("#saloon")
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("combat") then
		if state.combat and queue.current ~= "combat" then
			queue:combat()
		end
	elseif message_id == hash("start_saloon") then
		saloon.playing = true
		saloon.position = message.position
		saloon.music = sound.play("#saloon")
	elseif message_id == hash("stop_saloon") then
		saloon.playing = false
	end
end
