local state = require "main.state"

local saloon = {
	playing = false,
	position = vmath.vector3(),
}

local music = {
	sting = { "#sting1", "#sting2", "#sting3", "#sting4", "#sting5", },
	ambient = { "#ambient1", "#ambient2" },
	combat = "#combat",
	finale = { "#finale1", "#finale2", "#finale3", "#finale4", "#finale5", "#finale6", "#finale7", "#finale8",
		"#finale9", "#finale10", "#finale11", "#finale12", "#finale13", "#finale14", "#finale15", "#finale16", },
	saloon = "#saloon"
}

local queue = {
	current = nil,
	index = 1,
}

local current = {
	ambient = nil,
	sting = nil,
	combat = nil,
	finale = nil,
	saloon = nil,
}

-- Length of a single bar
local bar = 60 * 4 / 147

local function finale(message_id, id)
	if current.finale ~= id then return end
	current.finale = nil
	if message_id == hash("sound_done") then
		if saloon.playing then
			queue:saloon()
		else
			queue:ambient()
		end
	end
end

function queue:combat()
	if current.ambient then
		sound.stop(current.ambient)
		current.ambient = nil
	end
	if current.sting then
		sound.stop(current.sting)
		current.sting = nil
	end
	-- Play the combat loop
	current.combat = music.combat
	sound.set_gain(current.combat, 1)
	sound.play(music.combat)
	-- Play the corresponding finale, real quiet-like
	local index = 1
	local id = music.finale[index]
	current.finale = id
	sound.play(id, { gain = 0 }, function(self, message_id) finale(message_id, id) end)
	-- Every bar, check combat state and either switch finales or fade out
	timer.delay(bar, true, function(self, _t)
		if state.combat then
			sound.stop(current.finale)
			index = index % 16 + 1
			current.finale = music.finale[index]
			sound.play(current.finale, { gain = 0 }, function(self, message_id) finale(message_id) end)
		else
			print(current.combat)
			go.animate(current.combat, "gain", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_LINEAR, 0.25, 0, function()
				sound.stop(current.combat)
				current.combat = nil
			end)
			print(current.finale)
			go.animate(current.finale, "gain", go.PLAYBACK_ONCE_FORWARD, 1, go.EASING_LINEAR, 0.25)
			timer.cancel(_t)
		end
	end)
end

function queue:sting()
	-- Don't overlap
	if current.combat then return end
	if current.sting then
		sound.stop(current.sting)
	end

	local index = math.random(#music.sting)
	local id = music.sting[index]
	current.sting = id
	sound.play(current.sting, nil, function(self, message_id)
		if current.sting ~= id then return end
		current.sting = nil
		if message_id == hash("sound_done") then
			if not saloon.playing then
				queue:ambient()
			end
		end
	end)
end

function queue:ambient()
	-- Don't overlap
	if current.ambient then return end
	-- Play random ambient
	local index = math.random(#music.ambient)
	current.ambient = music.ambient[index]
	sound.play(current.ambient, nil, function(self, message_id)
		if message_id == hash("sound_done") and not current.ambient then
			queue:ambient()
		end
	end)
end

function queue:saloon()
	sound.play("#saloon")
	current.saloon = music.saloon
end

function init(self)
	-- Silence for debugging
	--sound.set_group_gain("master", 0)

	queue:ambient()
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	if saloon.playing and current.saloon then
		local player = state.player.position
		local direction = saloon.position - player
		local gain = 10000 / (vmath.length_sqr(direction) + 1)
		gain = math.min(gain, 1)
		local pan = direction.x / (math.abs(direction.y) + math.abs(direction.x) + 1)
		sound.set_gain("#saloon", gain)
		sound.set_pan("#saloon", pan)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("combat") then
		if state.combat and state.major() and not current.combat then
			queue:combat()
		end
	elseif message_id == hash("start_saloon") then
		saloon.playing = true
		saloon.position = message.position
	elseif message_id == hash("stop_saloon") then
		saloon.playing = false
		go.animate("#saloon", "gain", go.PLAYBACK_ONCE_FORWARD, 0, go.EASING_LINEAR, 1, 0,
			function()
				sound.stop("#saloon")
				queue:ambient()
			end)
	elseif message_id == hash("sting") then
		-- Play stings
		queue:sting()
	end
end
