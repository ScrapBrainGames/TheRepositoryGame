local state = require "modules.state"
local map = require "modules.map"

local function load_level(self, level)
	local url = msg.url()
	url.fragment = level
	self.current = url
	state.current = level
	state.level_url = url
	msg.post(url, "load")
end

function init(self)
	msg.post(".", "acquire_input_focus")
	load_level(self, hash("empty"))
	-- Spin the randomizer
	math.randomseed(os.time())
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "init")
		msg.post(sender, "enable")
	elseif message_id == hash("change_level") then
		if self.next then return end
		self.next = map.get(state.current, message.index)
		state.previous = self.current.fragment
		msg.post(self.current, "disable")
		msg.post(self.current, "final")
		msg.post(self.current, "unload")
	elseif message_id == hash("proxy_unloaded") then
		load_level(self, self.next)
		self.next = nil
	end
end

function on_input(self, action_id, action)
	-- Eventually, add a pause menu
end
