local weapons = require "modules.weapons"
local characters = require "modules.characters"
local ai = require "modules.ai"

-- Which character is this?
go.property("Character", "Clint")
go.property("radius", 18)

local function update_hud(self)
	if self.player then
		msg.post(self.hud, "chambers", { chambers = self.weapon.chambers })
	end
end

local function aim(self)
	self.aiming = true
	self.weapon:cycle()

	update_hud(self)
end

local function lower(self)
	self.aiming = false
	self.weapon.cocked = false
end

local function fire(self)
	if self.weapon.cocked then
		if self.weapon:fire() then
			-- Bang!
			local position = self.position
			local direction = self.target - position
			direction.z = 0
			direction = vmath.normalize(direction)
			position = position + direction * 32

			local props = {
				direction = direction,
				speed = 600,
				damage = 1,
				sender = go.get_id()
			}
			local bullet = factory.create("#factory", position, nil, props)
		else
			-- Click!
		end
	else
		-- Do we want the weapon to cycle on left click?
		--self.weapon:cycle()
	end
	update_hud(self)
end

function init(self)
	-- self state is used by both player and AI control
	self.position = vmath.vector3()
	self.direction = vmath.vector3()
	self.target = vmath.vector3()
	self.aiming = false
	-- Initialize per-character parameters like health, speed, and weapon
	characters.initialize(self)
	-- AI controls by default
	self.player = false
	self.ai = ai.new(self)
	-- Fill your hand, you son of a bitch
	self.weapon = weapons.get()
end

function update(self, dt)
	-- Set speed dependent on aiming or not
	local speed = self.aiming and self.aim_movement or self.normal_movement
	self.position = go.get_position()

	if self.player then
		local velocity = go.get("#collisionobject", "linear_velocity")
		ai.set_player_position(self.position, velocity)
	else
		local target = ai.get_player_position()
		local cast = physics.raycast(self.position, target, { hash("walls") })
		local sighted = cast == nil
		ai.update(self.ai, dt, sighted)
	end

	if self.direction.x ~= 0 or self.direction.y ~= 0 then
		self.direction = vmath.normalize(self.direction)
		msg.post("#collisionobject", "apply_force", { force = self.direction * speed, position = self.position })
	end

	self.direction.x = 0
	self.direction.y = 0
end

function on_message(self, message_id, message, sender)
	if message_id == hash("player control") then
		self.player = true
		self.hud = msg.url(sender.socket, sender.path, "weapon")
		update_hud(self)
		msg.post(".", "acquire_input_focus")
	elseif message_id == hash("damage") then
		self.health = self.health - message.damage
		if self.health <= 0 then
			go.delete()
		end
	end
end

function on_input(self, action_id, action)
	if action_id == hash("left") then
		self.direction.x = -1
	elseif action_id == hash("right") then
		self.direction.x = self.direction.x + 1
	elseif action_id == hash("up") then
		self.direction.y = 1
	elseif action_id == hash("down") then
		self.direction.y = self.direction.y - 1
	elseif action_id == hash("fire") and action.pressed then
		if self.aiming then
			fire(self)
		end
	elseif action_id == hash("aim") then
		if action.pressed then
			aim(self)
		elseif action.released then
			lower(self)
		end
	elseif action.x then
		self.target = camera.screen_xy_to_world(action.screen_x, action.screen_y)
	elseif action_id == hash("reload") then
		self.weapon:reload()
		update_hud(self)
	end
end
