local transition = require "modules.transition"

function init(self)
	-- Get level bounds
	--self.bounds = ???

	-- Start at first gate
	msg.post(".", "start")
end

function final(self)
	transition.reset()
end

function update(self, dt)

end

function late_update(self, dt)
	local player
	local target = vmath.vector3()
	local count = 0
	for char, play in pairs(transition.characters) do
		count = count + 1
		local position = go.get_position(char)
		target = target + position
		if play then
			player = position
			count = count + 1
			target = target + position
		end
	end
	if count > 0 then
		target = target / count
	end

	target.z = 50
	local current = go.get_position()
	--target = (target + 9 * current) * 0.1
	go.set_position(target)
end

