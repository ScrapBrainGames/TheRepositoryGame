[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 800
height = 600
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = 0.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = High Plains Grifter

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[collection_proxy]
max_count = 12

[particle_fx]
max_particle_count = 2048

[sound]
max_component_count = 128

