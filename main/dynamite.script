local fuse = 5

function update(self, dt)
	if self.fuse then
		self.fuse = self.fuse - dt
		if self.fuse <= 0 then
			self.fuse = nil
			print("kaboom!")
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("light") and not self.fuse then
		self.fuse = fuse
	end
end
